---
const { title = 'TerraForge | Industrial Processing Solutions' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Industrial crushing, screening and grinding solutions for aggregate and mining operations." />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/"><span class="brand-mark">T</span><span>TERRAFORGE</span></a>
      <nav aria-label="Main navigation">
        <a href="/products/">Products</a><a href="/#solutions">Solutions</a><a href="/#industries">Industries</a><a href="/#insights">Insights</a>
      </nav>
      <a class="header-action" href="/#contact">Talk to an expert <span>↗</span></a>
    </header>
    <main><slot /></main>
    <footer>
      <div class="footer-brand"><a class="brand" href="/"><span class="brand-mark">T</span><span>TERRAFORGE</span></a><p>Processing progress. Responsibly.</p></div>
      <div><h4>Explore</h4><a href="/products/">Products</a><a href="/#solutions">Solutions</a><a href="/#industries">Industries</a></div>
      <div><h4>Contact</h4><a href="mailto:solutions@terraforge.example">solutions@terraforge.example</a><a href="tel:+862158386256">+86 21 5838 6256</a><p>Global support, 24/7</p></div>
    </footer>
  </body>
</html>

<style is:global>
  :root { --ink:#121817; --mist:#edf0ec; --green:#006b58; --lime:#c8e46a; --warm:#f5f3ed; --line:#cad0cb; }
  * { box-sizing:border-box; } html { scroll-behavior:smooth; } body { margin:0; color:var(--ink); background:var(--warm); font-family:Manrope,Arial,sans-serif; } a { color:inherit; text-decoration:none; } .site-header { height:78px; padding:0 5.5vw; background:var(--warm); display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid var(--line); position:relative; z-index:5; } .brand { font-size:16px; font-weight:800; letter-spacing:.04em; display:flex; gap:10px; align-items:center; } .brand-mark { display:grid; place-items:center; width:25px; height:25px; color:white; background:var(--green); clip-path:polygon(50% 0,100% 25%,100% 75%,50% 100%,0 75%,0 25%); font-family:Georgia,serif; font-weight:700; } nav { display:flex; gap:30px; font-size:13px; font-weight:700; } nav a { transition:color .2s; } nav a:hover { color:var(--green); } .header-action { font-size:12px; font-weight:800; text-transform:uppercase; letter-spacing:.06em; background:var(--ink); color:white; padding:14px 17px; } .header-action span { color:var(--lime); margin-left:8px; } footer { background:var(--ink); color:white; padding:64px 5.5vw; display:grid; grid-template-columns:2fr 1fr 1fr; gap:35px; } footer .brand-mark { background:var(--lime); color:var(--ink); } footer p { color:#aeb7b1; font-size:13px; line-height:1.7; } footer h4 { color:var(--lime); font-size:11px; text-transform:uppercase; letter-spacing:.12em; margin:3px 0 17px; } footer div:not(.footer-brand) { display:flex; flex-direction:column; gap:10px; } footer a { font-size:13px; font-weight:600; } @media(max-width:760px){.site-header{height:64px;padding:0 5vw}.site-header nav{display:none}.header-action{font-size:10px;padding:11px}.brand{font-size:13px}footer{grid-template-columns:1fr;padding:48px 7vw}.header-action span{display:none}}
</style>
