---
import BaseLayout from '../layouts/BaseLayout.astro';
import { products } from '../data/products';
const featured = products.slice(0, 4);
---
<BaseLayout>
  <section class="hero">
    <div class="hero-copy"><p class="eyebrow">Industrial processing systems</p><h1>Performance<br />that moves<br /><em>the world.</em></h1><p class="intro">From quarry face to finished material, TerraForge supplies the equipment and engineering to keep your operation moving forward.</p><div class="hero-actions"><a class="button lime" href="/products/">Explore products <span>→</span></a><a class="text-link" href="#solutions">Build a solution <span>↘</span></a></div></div>
    <div class="hero-image"><img src="https://images.unsplash.com/photo-1494412519320-0d5c6a1a9e7c?auto=format&fit=crop&w=1800&q=85" alt="Industrial quarry operation" /><div class="hero-caption"><span>01</span><span>Aggregate processing / 2026</span></div></div>
  </section>

  <section class="statement"><p class="eyebrow">Built for better output</p><div><h2>Progress is measured in <em>every tonne.</em></h2><p>We unite equipment, process knowledge and lifecycle service to make minerals processing more productive, more predictable and more responsible.</p></div></section>

  <section class="business" id="industries"><div class="section-top"><p class="eyebrow">Our business</p><a class="text-link" href="/products/">View all products <span>→</span></a></div><div class="business-grid"><a href="/products/?family=Crushing" class="business-card quarry"><div><span>01</span><h3>Aggregates</h3><p>Crushing and screening systems that keep cost per tonne in control.</p></div><b>Explore ↗</b></a><a href="/products/?family=Grinding" class="business-card mill"><div><span>02</span><h3>Mineral<br />processing</h3><p>Grinding solutions for demanding industrial mineral applications.</p></div><b>Explore ↗</b></a><a href="/products/?family=Mobile" class="business-card mobile"><div><span>03</span><h3>Mobile<br />operations</h3><p>Flexible plants engineered for rapid deployment and reliable output.</p></div><b>Explore ↗</b></a></div></section>

  <section class="products-preview"><div class="section-top"><div><p class="eyebrow">Featured equipment</p><h2>Engineered to<br /><em>keep working.</em></h2></div><a class="button dark" href="/products/">Browse the range <span>→</span></a></div><div class="featured-grid">{featured.map((product, i) => <a class="product-tile" href={`/products/${product.slug}/`}><div class="tile-image"><img src={product.image} alt={product.name} /><span>0{i + 1}</span></div><p>{product.family} / {product.tag}</p><h3>{product.name}</h3><i>↗</i></a>)}</div></section>

  <section class="solutions" id="solutions"><div><p class="eyebrow">Complete solutions</p><h2>One partner.<br /><em>Every stage.</em></h2></div><div class="solution-list"><a href="/products/"><span>01</span><strong>Plant design & engineering</strong><b>→</b></a><a href="/products/"><span>02</span><strong>Equipment & systems</strong><b>→</b></a><a href="#contact"><span>03</span><strong>Service & lifecycle support</strong><b>→</b></a></div></section>

  <section class="contact" id="contact"><div><p class="eyebrow">Let's make progress</p><h2>Ready to redefine<br /><em>your operation?</em></h2></div><a class="button lime" href="mailto:solutions@terraforge.example">Talk to an expert <span>→</span></a></section>
  <section id="insights" class="insights"><p class="eyebrow">Insights</p><h2>Practical thinking<br />for the process ahead.</h2><a class="text-link" href="/products/">See our equipment range <span>→</span></a></section>
</BaseLayout>

<style>
  .hero{display:grid;grid-template-columns:1.02fr .98fr;min-height:680px}.hero-copy{padding:104px 7.5vw 68px 5.5vw;background:var(--mist);display:flex;flex-direction:column}.eyebrow{font-family:'DM Mono',monospace;font-size:10px;font-weight:500;letter-spacing:.1em;text-transform:uppercase;margin:0 0 25px;color:#426058}.hero h1{font-size:clamp(48px,5.8vw,94px);line-height:.95;letter-spacing:-.07em;margin:0;font-weight:700}.hero em,h2 em{font-family:Georgia,serif;font-weight:400;color:var(--green)}.intro{max-width:430px;font-size:16px;line-height:1.7;margin:38px 0 31px}.hero-actions{display:flex;gap:25px;align-items:center}.button{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.09em;padding:17px 20px;display:inline-flex;gap:22px;align-items:center}.button.lime{background:var(--lime)}.button.dark{background:var(--ink);color:white}.button span{font-size:19px}.text-link{font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.08em;border-bottom:1px solid var(--ink);padding-bottom:6px;width:max-content}.hero-image{min-height:550px;position:relative;overflow:hidden;background:#52635d}.hero-image:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 50%,rgba(0,0,0,.45))}.hero-image img{width:100%;height:100%;object-fit:cover;filter:saturate(.65) contrast(1.05)}.hero-caption{position:absolute;z-index:1;bottom:25px;left:28px;right:28px;color:white;display:flex;justify-content:space-between;font-family:'DM Mono',monospace;font-size:10px}.statement{padding:120px 10vw 126px 26vw;display:grid;grid-template-columns:160px 1fr;gap:35px;background:var(--warm)}h2{font-size:clamp(35px,4.5vw,70px);line-height:.98;letter-spacing:-.065em;margin:0}.statement>div p{font-size:16px;line-height:1.65;max-width:480px;margin:37px 0 0}.business{padding:78px 5.5vw 90px;background:var(--green);color:white}.section-top{display:flex;align-items:end;justify-content:space-between;margin-bottom:36px}.section-top .eyebrow{color:var(--lime);margin:0}.section-top .text-link{border-color:white}.business-grid{display:grid;grid-template-columns:1.15fr 1fr 1fr;gap:1px;background:rgba(255,255,255,.25)}.business-card{min-height:402px;padding:28px;display:flex;flex-direction:column;justify-content:space-between;background-size:cover;background-position:center;position:relative;isolation:isolate}.business-card:before{content:'';position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,rgba(0,20,17,.2),rgba(0,25,21,.78))}.quarry{background-image:url('https://images.unsplash.com/photo-1566408669364-4d25a24a3e77?auto=format&fit=crop&w=900&q=80')}.mill{background-image:url('https://images.unsplash.com/photo-1494412519320-0d5c6a1a9e7c?auto=format&fit=crop&w=900&q=80')}.mobile{background-image:url('https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?auto=format&fit=crop&w=900&q=80')}.business-card span{font-family:'DM Mono',monospace;font-size:11px}.business-card h3{font-size:34px;letter-spacing:-.06em;line-height:.95;margin:0 0 15px}.business-card p{max-width:270px;font-size:13px;line-height:1.55;margin:0}.business-card b{font-size:11px;text-transform:uppercase;letter-spacing:.08em}.products-preview{padding:115px 5.5vw;background:var(--warm)}.products-preview h2{margin-top:12px}.featured-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.product-tile{position:relative}.tile-image{height:270px;position:relative;background:#d6dcd7;overflow:hidden}.tile-image img{width:100%;height:100%;object-fit:cover;filter:grayscale(.7) saturate(.7)}.tile-image span{position:absolute;top:15px;left:16px;background:var(--lime);font-family:'DM Mono',monospace;font-size:10px;padding:8px}.product-tile p{font-family:'DM Mono',monospace;text-transform:uppercase;color:#52615b;font-size:9px;letter-spacing:.08em;margin:18px 0 8px}.product-tile h3{font-size:19px;letter-spacing:-.04em;margin:0}.product-tile i{position:absolute;right:0;bottom:0;font-style:normal;font-size:20px;color:var(--green)}.solutions{padding:112px 11vw;background:var(--mist);display:grid;grid-template-columns:1fr 1fr;gap:7vw}.solutions h2{margin-top:12px}.solution-list{border-top:1px solid var(--line)}.solution-list a{padding:23px 0;border-bottom:1px solid var(--line);display:grid;grid-template-columns:45px 1fr 20px;align-items:center}.solution-list span{font-family:'DM Mono',monospace;font-size:10px;color:#56726a}.solution-list strong{font-size:18px;letter-spacing:-.035em}.solution-list b{color:var(--green)}.contact{padding:94px 11vw;background:var(--ink);color:white;display:flex;justify-content:space-between;align-items:center}.contact .eyebrow{color:var(--lime)}.contact h2 em{color:var(--lime)}.insights{padding:90px 11vw;background:var(--warm)}.insights h2{margin:12px 0 30px}@media(max-width:820px){.hero{grid-template-columns:1fr}.hero-copy{padding:80px 7vw 55px}.hero-image{min-height:400px}.statement{padding:75px 7vw;grid-template-columns:1fr}.business{padding:60px 7vw}.business-grid,.featured-grid{grid-template-columns:1fr 1fr}.business-card{min-height:300px}.products-preview{padding:75px 7vw}.solutions{padding:75px 7vw;grid-template-columns:1fr}.contact{padding:70px 7vw;display:block}.contact .button{margin-top:30px}}@media(max-width:500px){.business-grid,.featured-grid{grid-template-columns:1fr}.section-top{align-items:start;gap:20px;flex-direction:column}.tile-image{height:220px}.hero-actions{align-items:flex-start;flex-direction:column}}
</style>
