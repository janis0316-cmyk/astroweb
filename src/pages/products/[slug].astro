---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products } from '../../data/products';
export function getStaticPaths() { return products.map(product => ({ params: { slug: product.slug }, props: { product } })); }
const { product } = Astro.props;
const related = products.filter((item) => item.family === product.family && item.slug !== product.slug).slice(0, 3);
---
<BaseLayout title={`${product.name} | TerraForge`}>
  <section class="detail-hero"><div><a class="back" href="/products/">← All products</a><p class="eyebrow">{product.family} / {product.tag}</p><h1>{product.name}</h1><p class="intro">{product.description}</p><a class="button lime" href="#inquiry">Request a quote <span>→</span></a></div><div class="product-visual"><img src={product.image} alt={product.name} /><span>TF / {product.family.toUpperCase()}</span></div></section>
  <section class="specs"><div><p class="eyebrow">At a glance</p><h2>Designed around<br /><em>your process.</em></h2></div><div class="spec-list"><div><span>Application</span><strong>{product.tag}</strong></div><div><span>Output / capacity</span><strong>{product.capacity}</strong></div><div><span>Support</span><strong>Global engineering service</strong></div></div></section>
  <section class="process"><p class="eyebrow">Performance in practice</p><div><h2>Equipment that earns its place in the <em>process flow.</em></h2><p>Every TerraForge machine is selected around material characteristics, operating targets and lifecycle demands. Our specialists help define the configuration that moves your operation forward.</p></div></section>
  <section class="inquiry" id="inquiry"><div><p class="eyebrow">Talk to an expert</p><h2>Let's find your<br /><em>right fit.</em></h2></div><form><label>Name<input type="text" placeholder="Your name" /></label><label>Email<input type="email" placeholder="you@company.com" /></label><label>Message<textarea placeholder={`Tell us about your ${product.name} project`}></textarea></label><button class="button lime" type="button">Send inquiry <span>→</span></button></form></section>
  {related.length > 0 && <section class="related"><div class="related-head"><div><p class="eyebrow">More {product.family} equipment</p><h2>Keep exploring.</h2></div><a class="text-link" href="/products/">All products →</a></div><div class="related-grid">{related.map(item => <a href={`/products/${item.slug}/`}><img src={item.image} alt={item.name} /><p>{item.tag}</p><h3>{item.name}</h3></a>)}</div></section>}
</BaseLayout>
<style>
  .detail-hero{display:grid;grid-template-columns:1fr 1fr;min-height:590px;background:var(--mist)}.detail-hero>div:first-child{padding:55px 7vw 65px 11vw;display:flex;flex-direction:column;align-items:flex-start}.back{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.08em;border-bottom:1px solid;padding-bottom:5px;margin-bottom:auto}.eyebrow{font-family:'DM Mono',monospace;font-size:10px;text-transform:uppercase;letter-spacing:.1em;color:#426058}.detail-hero h1{font-size:clamp(42px,5vw,76px);line-height:.94;letter-spacing:-.07em;margin:10px 0 22px}.intro{font-size:16px;line-height:1.65;max-width:430px;margin:0 0 29px}.button{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.09em;padding:17px 20px;display:inline-flex;gap:22px;align-items:center;border:0;cursor:pointer}.button.lime{background:var(--lime)}.button span{font-size:19px}.product-visual{position:relative;overflow:hidden;background:#727c76}.product-visual:after{content:'';inset:0;position:absolute;background:linear-gradient(145deg,rgba(0,41,32,.18),rgba(0,0,0,.35))}.product-visual img{width:100%;height:100%;object-fit:cover;filter:grayscale(.75) contrast(1.05)}.product-visual span{position:absolute;z-index:1;bottom:25px;left:28px;color:white;font:10px 'DM Mono',monospace;letter-spacing:.1em}.specs{padding:103px 11vw;display:grid;grid-template-columns:1fr 1fr;gap:8vw}.specs h2,.process h2,.inquiry h2,.related h2{font-size:clamp(36px,4.3vw,65px);line-height:.98;letter-spacing:-.065em;margin:14px 0}.specs em,.process em,.inquiry em{font-family:Georgia,serif;font-weight:400;color:var(--green)}.spec-list{border-top:1px solid var(--line)}.spec-list div{padding:20px 0;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;gap:25px}.spec-list span{font-family:'DM Mono',monospace;font-size:10px;text-transform:uppercase;color:#587069}.spec-list strong{font-size:13px;text-align:right}.process{background:var(--green);color:white;padding:90px 11vw;display:grid;grid-template-columns:1fr 1.1fr;gap:8vw}.process .eyebrow{color:var(--lime)}.process em{color:var(--lime)}.process>div p{max-width:520px;font-size:16px;line-height:1.7;margin:30px 0}.inquiry{background:var(--mist);padding:95px 11vw;display:grid;grid-template-columns:1fr 1fr;gap:8vw}.inquiry form{display:flex;flex-direction:column;gap:18px}.inquiry label{font-family:'DM Mono',monospace;font-size:10px;text-transform:uppercase;letter-spacing:.08em;color:#48635b;display:grid;gap:8px}.inquiry input,.inquiry textarea{padding:13px 0;border:0;border-bottom:1px solid #aebbb5;background:transparent;font:14px Manrope,sans-serif;outline:0}.inquiry textarea{resize:vertical;min-height:70px}.inquiry .button{width:max-content;margin-top:8px}.related{padding:90px 11vw}.related-head{display:flex;align-items:end;justify-content:space-between;margin-bottom:35px}.text-link{font-size:11px;text-transform:uppercase;letter-spacing:.08em;font-weight:800;border-bottom:1px solid;padding-bottom:5px}.related-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.related-grid img{width:100%;height:210px;object-fit:cover;filter:grayscale(.7)}.related-grid p{font:9px 'DM Mono',monospace;text-transform:uppercase;letter-spacing:.08em;color:#4c6d62;margin:14px 0 7px}.related-grid h3{font-size:20px;letter-spacing:-.05em;margin:0}@media(max-width:700px){.detail-hero,.specs,.process,.inquiry{grid-template-columns:1fr}.detail-hero>div:first-child{padding:45px 7vw 55px}.product-visual{min-height:350px}.specs,.process,.inquiry,.related{padding:70px 7vw}.back{margin-bottom:70px}.related-grid{grid-template-columns:1fr}.related-grid img{height:250px}}
</style>
