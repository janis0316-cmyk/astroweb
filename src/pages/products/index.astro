---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products, families } from '../../data/products';
---
<BaseLayout title="Products | TerraForge">
  <section class="product-hero"><p class="eyebrow">Equipment portfolio</p><h1>Built to process<br /><em>what matters.</em></h1><p>Explore a complete range of Zenith-sourced crushing, mobile, grinding and process equipment, re-presented for the TerraForge portfolio.</p></section>
  <section class="catalogue"><div class="catalogue-head"><p><strong>{products.length}</strong> products for aggregate and mineral processing</p><div class="filters">{families.map((family, index) => <button class:list={{ active: index === 0 }} data-filter={family}>{family}</button>)}</div></div><div class="product-grid">{products.map((product, i) => <a class="catalogue-card" data-family={product.family} href={`/products/${product.slug}/`}><div class="catalogue-image"><img src={product.image} alt={product.name} loading="lazy" /><span>0{i + 1}</span><small>{product.family}</small></div><div class="catalogue-copy"><p>{product.tag}</p><h2>{product.name}</h2><span>{product.capacity}</span></div><b>↗</b></a>)}</div></section>
</BaseLayout>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-family]');
  buttons.forEach(button => button.addEventListener('click', () => { const filter = button.dataset.filter; buttons.forEach(item => item.classList.toggle('active', item === button)); cards.forEach(card => card.hidden = filter !== 'All' && card.dataset.family !== filter); }));
</script>
<style>
  .product-hero{background:var(--mist);padding:92px 5.5vw 82px;display:grid;grid-template-columns:1.4fr 1fr;gap:8vw;align-items:end}.eyebrow{font-family:'DM Mono',monospace;font-size:10px;text-transform:uppercase;letter-spacing:.1em;color:#426058}.product-hero h1{grid-column:1;font-size:clamp(50px,6.5vw,96px);line-height:.91;letter-spacing:-.075em;margin:18px 0 0}.product-hero h1 em{font-family:Georgia,serif;font-weight:400;color:var(--green)}.product-hero>p:last-child{font-size:16px;line-height:1.7;margin:0 0 7px}.catalogue{padding:63px 5.5vw 110px}.catalogue-head{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line);padding-bottom:22px;margin-bottom:32px}.catalogue-head p{font-size:13px}.catalogue-head strong{color:var(--green);font-size:28px;letter-spacing:-.05em;margin-right:6px}.filters{display:flex;gap:8px;flex-wrap:wrap}.filters button{border:1px solid var(--line);background:transparent;padding:9px 12px;font:700 10px Manrope,sans-serif;text-transform:uppercase;letter-spacing:.07em;cursor:pointer}.filters button.active{background:var(--green);border-color:var(--green);color:white}.product-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:34px 20px}.catalogue-card{position:relative}.catalogue-image{height:255px;background:#dce0dc;position:relative;overflow:hidden}.catalogue-image img{width:100%;height:100%;object-fit:cover;filter:grayscale(.7) saturate(.7);transition:transform .4s}.catalogue-card:hover img{transform:scale(1.05)}.catalogue-image span,.catalogue-image small{position:absolute;top:14px;font-family:'DM Mono',monospace;font-size:10px}.catalogue-image span{left:14px;background:var(--lime);padding:7px}.catalogue-image small{right:14px;color:white;text-transform:uppercase;letter-spacing:.08em}.catalogue-copy{padding:16px 28px 0 0}.catalogue-copy p{margin:0 0 7px;color:#527169;font-family:'DM Mono',monospace;text-transform:uppercase;font-size:9px;letter-spacing:.08em}.catalogue-copy h2{font-size:21px;letter-spacing:-.05em;margin:0 0 7px}.catalogue-copy span{font-size:11px;color:#516059}.catalogue-card>b{position:absolute;right:0;bottom:0;color:var(--green);font-size:20px}@media(max-width:760px){.product-hero{padding:70px 7vw;display:block}.product-hero>p:last-child{margin-top:30px}.catalogue{padding:45px 7vw 80px}.catalogue-head{align-items:flex-start;flex-direction:column;gap:20px}.product-grid{grid-template-columns:1fr 1fr}.catalogue-image{height:210px}}@media(max-width:460px){.product-grid{grid-template-columns:1fr}}
</style>
